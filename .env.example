# ── OpenAI (required for multi-agent chat) ───────────────
OPENAI_API_KEY=sk-your-key-here
AI_ASSISTANT_AGENT_ENABLED=1
AI_ASSISTANT_MODEL=gpt-4o-mini

# ── News Analyst agent (optional, specialized News chatbot) ──
NEWS_ANALYST_AGENT_ENABLED=1
NEWS_ANALYST_MODEL=gpt-4o-mini
NEWS_ANALYST_TAVILY_ENABLED=1
NEWS_ANALYST_TAVILY_MAX_RESULTS=5
TAVILY_API_KEY=

# ── ElevenLabs Voice (optional, for realtime voice companion) ─
# Để trống nếu chỉ dùng voice local trong browser.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_SECONDS=8

# ── API Security (optional, leave empty to disable) ─────
API_SECRET_KEY=
# When set, all requests except /health and /docs must include
# header: X-API-Key: <value>

# ── Google login (optional) ──────────────────────────────
# Client ID trong Google OAuth consent/web client. Service account JSON không dùng cho user login.
GOOGLE_OAUTH_CLIENT_ID=483150503670-hd2qvbcvaq0qqre21qn94mgq21o9559k.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=483150503670-hd2qvbcvaq0qqre21qn94mgq21o9559k.apps.googleusercontent.com

# ── Trading Lab (admin only — optional) ───────────────────
# Khi đặt, endpoint POST /admin/trading-lab/chat yêu cầu header:
#   X-Admin-Trading-Lab-Key: <cùng giá trị>
# Dùng để test chiến lược LLM + tools; không kết nối broker.
ADMIN_TRADING_LAB_KEY=1234
# Local-only switch: lets you test Pro Lab and private paper trading controls
# without onboarding/pro eligibility. Keep this off in production.
PRO_LAB_LOCAL_TEST_OPEN=1
# TRADING_LAB_MODEL=gpt-4o-mini

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Finnhub (optional — macro calendar + quote strip on News desk) ──
# Free tier ~60 req/min; backend caches calendar ~30m, quotes ~50s.
FINNHUB_API_KEY=

# ── Watchlist OHLCV (optional) ───────────────────────────
# Khi backend khởi động, đồng bộ cache giá/khối lượng (yfinance → data/watchlist_prices/)
# cho các mã liệt kê (phân tách bằng dấu phẩy). Tab Góc theo dõi cũng gọi đồng bộ khi mở.
# WATCHLIST_PRICE_SYNC_TICKERS=FPT,VIC

# ── Data paths (defaults work out-of-the-box) ───────────
# DATA_DIR=./data
# MODEL_DIR=./data/models
