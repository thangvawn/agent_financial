# ── Database (transactional SQLite — one file) ───────────
# Canonical path. Compat: RISK_DASHBOARD_APP_STATE_DB / RISK_DASHBOARD_SQLITE
# Default: data/db/northstar.db
# RISK_DASHBOARD_DB_PATH=data/db/northstar.db

# BCTC upload directory (default data/financial_uploads)
# RISK_DASHBOARD_FINANCIAL_UPLOADS_DIR=data/financial_uploads

# ── OpenAI (optional — Pro Lab structured AI tools if enabled) ─
OPENAI_API_KEY=sk-your-key-here
TELEGRAM_TRANSLATION_MODEL=gpt-4o-mini

# ── API Security (optional, leave empty to disable) ─────
API_SECRET_KEY=
# When set, all requests except /health, /ready and /docs must include
# header: X-API-Key: <value>
# Dedicated key for POST /admin/load-panel when API_SECRET_KEY is empty.
ADMIN_SYSTEM_KEY=

# ── VN market realtime feed ──────────────────────────────
# Scheduler keeps the quote-board cache warm; requests serve the last good
# snapshot immediately while a stale cache refreshes in the background.
ENABLE_VN_MARKET_SCHEDULER=1
# Preferred feed provider: "ssi" (fast ~0.6s all exchanges, default), "vnstock", or "vci"
VN_MARKET_PROVIDER=ssi
VN_MARKET_INTERVAL_FAST_SEC=12
VN_MARKET_INTERVAL_SLOW_SEC=300
VN_MARKET_UNIVERSE_INTERVAL_SEC=21600
VN_MARKET_PREFETCH_INTERVAL_SEC=7200
# Global/yahoo cross-asset snapshot refresh cadence (seconds).
GLOBAL_MARKET_INTERVAL_SEC=60
# Maximum age accepted by an HTTP request before it refreshes the cross-asset
# cache. Keep this at or above the scheduler cadence to avoid duplicate calls.
GLOBAL_MARKET_CACHE_TTL_SEC=75

# ── Google login (optional) ──────────────────────────────
# Client ID trong Google OAuth consent/web client. Service account JSON không dùng cho user login.
GOOGLE_OAUTH_CLIENT_ID=483150503670-hd2qvbcvaq0qqre21qn94mgq21o9559k.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=483150503670-hd2qvbcvaq0qqre21qn94mgq21o9559k.apps.googleusercontent.com

# ── Trading Lab / Pro Lab admin (optional) ────────────────
# Khi đặt, admin bootstrap yêu cầu header X-Admin-Trading-Lab-Key.
ADMIN_TRADING_LAB_KEY=1234
# Local-only switch: lets you test Pro Lab without onboarding/pro eligibility.
PRO_LAB_LOCAL_TEST_OPEN=1

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Finnhub (optional — macro calendar + quote strip on News desk) ──
# Free tier ~60 req/min; backend caches calendar ~30m, quotes ~50s.
FINNHUB_API_KEY=

# ── Telegram Gateway & Bot Daemon ─────────────────────
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram Default Chat ID (e.g. 123456789 or channel username)
TELEGRAM_CHAT_ID=
TELEGRAM_DEFAULT_CHAT_ID=
# Domain-specific Chat IDs (optional, fallback to DEFAULT_CHAT_ID)
# TELEGRAM_MARKET_CHAT_ID=
# TELEGRAM_NEWS_CHAT_ID=
# TELEGRAM_LEARN_CHAT_ID=
# TELEGRAM_BCTC_CHAT_ID=

# Access Control (Comma-separated Chat IDs & Admin User IDs)
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=

# Watchlist tickers for BCTC Release Alerts
TELEGRAM_BCTC_WATCHLIST=FPT,HPG,VNM,VCB

# Daemon Lock File Path (defaults to var/run/telegram_bot_daemon.lock)
TELEGRAM_DAEMON_LOCK_FILE=var/run/telegram_bot_daemon.lock

ENABLE_TELEGRAM_NEWS_SCHEDULER=0
# Vietnam time (Asia/Ho_Chi_Minh)
TELEGRAM_DAILY_TIME=18:30
TELEGRAM_WEEKLY_TIME=19:00
# 0=Monday ... 6=Sunday
TELEGRAM_WEEKLY_WEEKDAY=6
# Monthly digest runs on the last day of each month.
TELEGRAM_MONTHLY_TIME=19:30
TELEGRAM_DIGEST_MAX_ITEMS=6

# ── Watchlist OHLCV (optional) ───────────────────────────
# WATCHLIST_PRICE_SYNC_TICKERS=FPT,VIC

# ── Data paths (defaults work out-of-the-box) ───────────
# DATA_DIR=./data
# MODEL_DIR=./data/models

# === AI Runtime (Agentic Quantum) ===
AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_ENABLED=0
GEMINI_API_KEY=
# Chỉ bật khi phát triển offline; production phải cấu hình provider thật.
AGENTIC_ALLOW_FAKE_PROVIDER=0

# === Staging Overrides Example ===
# ENVIRONMENT=staging
# DEBUG=0
# LOG_LEVEL=INFO
# GEMINI_API_KEY=${GEMINI_API_KEY}

# News RSS cache refresh interval (seconds; minimum 15). The News UI polls
# every 30 seconds while visible and receives the newest persisted feed.
# NEWS_CACHE_TTL_SECONDS=60
