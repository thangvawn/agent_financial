# ── Database (transactional SQLite — one file) ───────────
# Canonical path. Compat: RISK_DASHBOARD_APP_STATE_DB / RISK_DASHBOARD_SQLITE
# Default: data/db/northstar.db
# RISK_DASHBOARD_DB_PATH=data/db/northstar.db

# BCTC upload directory (default data/financial_uploads)
# RISK_DASHBOARD_FINANCIAL_UPLOADS_DIR=data/financial_uploads

# ── OpenAI (optional — Pro Lab structured AI tools if enabled) ─
OPENAI_API_KEY=sk-your-key-here
TELEGRAM_TRANSLATION_MODEL=gpt-4o-mini

# ── API Security (optional, leave empty to disable) ─────
API_SECRET_KEY=
# When set, all requests except /health and /docs must include
# header: X-API-Key: <value>

# ── Google login (optional) ──────────────────────────────
# Client ID trong Google OAuth consent/web client. Service account JSON không dùng cho user login.
GOOGLE_OAUTH_CLIENT_ID=483150503670-hd2qvbcvaq0qqre21qn94mgq21o9559k.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=483150503670-hd2qvbcvaq0qqre21qn94mgq21o9559k.apps.googleusercontent.com

# ── Trading Lab / Pro Lab admin (optional) ────────────────
# Khi đặt, admin bootstrap yêu cầu header X-Admin-Trading-Lab-Key.
ADMIN_TRADING_LAB_KEY=1234
# Local-only switch: lets you test Pro Lab without onboarding/pro eligibility.
PRO_LAB_LOCAL_TEST_OPEN=1

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Finnhub (optional — macro calendar + quote strip on News desk) ──
# Free tier ~60 req/min; backend caches calendar ~30m, quotes ~50s.
FINNHUB_API_KEY=

# ── Telegram News Digest (optional) ─────────────────────
# Scheduler stays off until explicitly enabled.
TELEGRAM_BOT_TOKEN=8766761688:AAF0eXWVondof_1hq7wkNgR27Tj4_grCOmo
TELEGRAM_CHAT_ID=@northstar_market_brief
ENABLE_TELEGRAM_NEWS_SCHEDULER=0
# Vietnam time (Asia/Ho_Chi_Minh)
TELEGRAM_DAILY_TIME=18:30
TELEGRAM_WEEKLY_TIME=19:00
# 0=Monday ... 6=Sunday
TELEGRAM_WEEKLY_WEEKDAY=6
# Monthly digest runs on the last day of each month.
TELEGRAM_MONTHLY_TIME=19:30
TELEGRAM_DIGEST_MAX_ITEMS=6

# ── Watchlist OHLCV (optional) ───────────────────────────
# WATCHLIST_PRICE_SYNC_TICKERS=FPT,VIC

# ── Data paths (defaults work out-of-the-box) ───────────
# DATA_DIR=./data
# MODEL_DIR=./data/models
